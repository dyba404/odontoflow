    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@odontoflow/core": "*",
    "@odontoflow/db": "^0.1.0",
    "@odontoflow/ui": "*",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "file-type": "^22.0.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.31.0",
    "next": "^15.1.6",
    "nodemailer": "^9.0.5",
