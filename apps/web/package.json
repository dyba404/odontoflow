{
  "name": "@odontoflow/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint --dir src",
    "test:unit": "node --test --import tsx \"src/lib/storage.test.ts\" \"src/lib/events.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:vivo": "playwright test --config playwright.vivo.config.ts --workers=3 --project vivo --project movil-vivo",
    "test:e2e:vivo-serie": "playwright test --config playwright.vivo.config.ts --project vivo-serie",
    "test:e2e:admin": "playwright test --config playwright.admin.config.ts"
  },
