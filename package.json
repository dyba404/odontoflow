{
  "name": "odontoflow",
  "private": true,
  "version": "0.1.0",
  "description": "SaaS de gestión para consultorios odontológicos en Perú",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @odontoflow/web",
    "build": "npm run build -w @odontoflow/db -w @odontoflow/core -w @odontoflow/ui -w @odontoflow/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test -w @odontoflow/core",
    "test:e2e": "npm run test:e2e -w @odontoflow/web",
    "test:e2e:vivo": "npm run test:e2e:vivo -w @odontoflow/web",
    "test:e2e:vivo-serie": "npm run test:e2e:vivo-serie -w @odontoflow/web",
    "test:e2e:admin": "npm run test:e2e:admin -w @odontoflow/web",
    "e2e:funcional": "node scripts/e2e-funcional.js",
    "of:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/of.ps1 up",
    "of:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/of.ps1 down",
    "of:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/of.ps1 status",
    "of:db": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/of.ps1 db",
    "of:serve": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/serve-console.ps1",
    "db:generate": "npm run db:generate -w @odontoflow/db",
    "db:migrate": "npm run db:migrate -w @odontoflow/db",
    "db:seed": "npm run db:seed -w @odontoflow/db",
    "db:seed:founder": "npm run db:seed:founder -w @odontoflow/db",
    "db:seed-piloto": "npm run db:seed-piloto -w @odontoflow/db",
    "admin:change-password": "npm run admin:change-password -w @odontoflow/db"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23"
  }
}
